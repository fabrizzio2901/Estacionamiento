# Base de Datos
DATABASE_URL="postgresql://tu_usuario:tu_password@localhost:5432/parking_db"

# JWT
JWT_SECRET="tu_clave_secreta_muy_segura_aqui_2024"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# MQTT (opcional)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_TOPIC_PREFIX="parking/sensor"

# ─── Stripe — usa claves sk_test_... para Test Mode ───────────────────────
# Obtén tus claves en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."          # para webhooks de pagos de sesión
STRIPE_WALLET_WEBHOOK_SECRET="whsec_..."   # para webhooks de recargas de billetera (puede ser el mismo)

# RF-06: Clave para encriptar el payload del QR (AES-256)
# Genera una clave segura con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET="cambia_esta_clave_por_una_aleatoria_segura"

# Tarifas por defecto
TARIFA_POR_HORA=20
TARIFA_MONEDA="MXN"
